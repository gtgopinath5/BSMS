# ── Copy to .env and adjust ───────────────────────────────
# Default values let the API boot locally with zero external services
# (SQLite DB, in-memory timer). Switch to Postgres/Redis/MinIO for full stack.

# Database — SQLite by default; Postgres example commented below
DATABASE_URL=sqlite:///./baywatch.db
# DATABASE_URL=postgresql+psycopg://baywatch:baywatch@localhost:5432/baywatch

# Redis — optional. If unreachable, the timer falls back to in-process memory.
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# JWT
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# MinIO / S3 — optional. If unset, signed-URL helpers return mock signed URLs.
MINIO_URL=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_REGION=us-east-1

# Recording retention
RECORDING_RETENTION_DAYS=14

# MQTT — ESP32 physical bay timers. brew install mosquitto && brew services start mosquitto
# Backend publishes timer state/events; ESP32 only displays. Dormant if unreachable.
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_ENABLED=true
MQTT_TOPIC_PREFIX=bay

# CORS — frontend dev server origin(s), comma separated
CORS_ORIGINS=http://localhost:7890,http://localhost:3000

# Notifications (optional) — SMS via MSG91 (India), Email via SendGrid
MSG91_AUTH_KEY=
MSG91_SENDER_ID=BAYWTC      # 6-char DLT-approved sender id
MSG91_FLOW_ID=              # DLT template/flow id (v5 API); blank = legacy route
MSG91_ROUTE=4               # legacy route: 4 = transactional
SENDGRID_API_KEY=
FROM_EMAIL=noreply@baywatch.app

# Seed demo data on first startup (branches, admin, workers, bays, parts)
SEED_ON_STARTUP=true

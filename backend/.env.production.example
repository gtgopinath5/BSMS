# ════════════════════════════════════════════════════════════════════
#  BAYWATCH — PRODUCTION environment template
#  Copy to `.env.production`, fill REAL values, keep it OUT of git
#  (the repo .gitignore already ignores .env / *.env).  NEVER commit secrets.
#
#  With APP_ENV=production the backend FAILS FAST on insecure config
#  (weak JWT, SQLite, default seed, localhost watch URL, wildcard CORS,
#  non-writable media). Optional integrations (Drive/WhatsApp/MQTT) stay
#  optional and only warn. See DEPLOYMENT_RUNBOOK.md.
# ════════════════════════════════════════════════════════════════════

# Deployment profile — enables production startup validation.
APP_ENV=production

# ── Database (REQUIRED) — PostgreSQL only in production ──────────────
# SQLite is rejected in production. Use a managed/owned Postgres.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@db-host:5432/baywatch

# ── Redis (REQUIRED for persistent bay timers across restarts) ──────
REDIS_URL=redis://redis-host:6379/0
CELERY_BROKER_URL=redis://redis-host:6379/1

# ── Secrets (REQUIRED) — generate with: openssl rand -hex 32 ────────
# JWT_SECRET signs login tokens. Rotating it logs everyone out (expected).
JWT_SECRET=__REPLACE_WITH_openssl_rand_hex_32__
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720
# Fernet key encrypting provider secrets in the integration_settings table.
# REQUIRED in production (do not let it derive from JWT_SECRET).
INTEGRATION_SECRET_KEY=__REPLACE_WITH_openssl_rand_hex_32__

# ── Seeding (REQUIRED off in production) ────────────────────────────
# Auto-seed creates default-password admin/master/worker. Keep it FALSE.
# One-time bootstrap: run a single boot WITHOUT APP_ENV=production (or on a
# staging box) to seed, change every password via the API, then deploy with
# SEED_ON_STARTUP=false + APP_ENV=production.
SEED_ON_STARTUP=false

# ── Public origins (REQUIRED) ───────────────────────────────────────
# Customer Live-Watch links are built from this — must be the PUBLIC https
# origin that serves the backend (NOT localhost), or customer links break.
CUSTOMER_WATCH_BASE_URL=https://baywatch.example.com
CUSTOMER_WATCH_TTL_HOURS=12
# Lock CORS to your real admin/worker frontend origin(s). No wildcard '*'.
CORS_ORIGINS=https://app.baywatch.example.com

# ── Recording media (REQUIRED writable, persistent volume) ──────────
BW_MEDIA_ROOT=/data/baywatch/media
RECORDING_RETENTION_DAYS=14

# ── Optional integrations — leave blank to keep dormant (never blocks) ──
# Google Drive archival (needs google-api-python-client + google-auth in the
# image; see DEPLOYMENT_RUNBOOK.md). Unset → recordings stay on local SSD.
GOOGLE_DRIVE_CREDENTIALS=
GOOGLE_DRIVE_FOLDER_ID=

# MQTT — ESP32 physical bay timers. Unset/disabled → backend timer is truth.
MQTT_ENABLED=false
MQTT_BROKER_HOST=
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=bay

# WhatsApp Business (Meta Cloud API). Unset → Copy-Link still works.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=service_live_link
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_API_VERSION=v21.0
WHATSAPP_DEFAULT_COUNTRY_CODE=91

# Notifications (optional) — SMS via MSG91, Email via SendGrid.
MSG91_AUTH_KEY=
MSG91_SENDER_ID=BAYWTC
MSG91_FLOW_ID=
MSG91_ROUTE=4
SENDGRID_API_KEY=
FROM_EMAIL=noreply@baywatch.example.com

# Object storage (optional) — change from minioadmin if MinIO is reachable.
MINIO_URL=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_REGION=us-east-1
